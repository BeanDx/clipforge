{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "clipforge",
  "version": "0.12.1",
  "identifier": "com.clipforge.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/bundle-parser.cjs"
  },
  "app": {
    "windows": [
      {
        "title": "clipforge",
        "width": 1400,
        "height": 760,
        "minWidth": 960,
        "minHeight": 540,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#07090d"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["parser/**/*", "sky/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGMDFFMUIxMTJBOUJFMEIKUldRTHZxa1NzZUVCYjRPUzBWYzR4UnBQMmVGcWdoRFdxdVNUSVpsVXA0VGxMdGJRdDV0R1o1cEQK",
      "endpoints": ["https://github.com/BeanDx/clipforge/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
